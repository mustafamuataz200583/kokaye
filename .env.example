# ---------------------------------------------------------------
# KOKAYE — environment variables (copy to .env.local and fill in)
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------

# Public site URL (used for SEO / sitemap / share links)
NEXT_PUBLIC_SITE_URL=https://kokaye.example

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY — used for product image uploads to Storage. Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER ONLY — Supabase → Project Settings → Database → Connection string
# Use the "Transaction pooler" URI (port 6543) on Vercel.
DATABASE_URL=postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# SERVER ONLY — any long random string; used to hash visitor IPs for rate limiting.
RATE_LIMIT_SALT=change-me-to-a-long-random-string
